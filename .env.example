# Copy this file to ".env" and fill in real values.
# The .env file is git-ignored so your secrets never get committed.
#
# When ANTHROPIC_API_KEY is set to a real key (starts with "sk-ant-"), the app
# automatically uses the real Claude API. Remove/blank it to use the offline mock.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown):
# VE_MODEL=claude-opus-4-8
# VE_ANALYSIS_MODEL=claude-opus-4-8
# VE_CHAT_MAX_TOKENS=4096
# VE_ANALYSIS_MAX_TOKENS=8000
