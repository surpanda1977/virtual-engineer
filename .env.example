# Copy this file to ".env" and fill in real values.
# The .env file is git-ignored so your secrets never get committed.
#
# When ANTHROPIC_API_KEY is set to a real key (starts with "sk-ant-"), the app
# automatically uses the real Claude API. Remove/blank it to use the offline mock.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown):
# VE_MODEL=claude-opus-4-8
# VE_ANALYSIS_MODEL=claude-opus-4-8
# VE_CHAT_MAX_TOKENS=4096
# VE_ANALYSIS_MAX_TOKENS=8000

# --- ITSM data source (Incident Diagnostics) ---
# Default is "mock" (reads the local CSVs in data/). Set to "servicenow" and fill
# in the credentials below to pull live data from ServiceNow instead.
# VE_ITSM_SOURCE=mock
# SERVICENOW_INSTANCE=dev123456            # or a full https URL
# SERVICENOW_USER=your-user                # basic auth …
# SERVICENOW_PASSWORD=your-password
# SERVICENOW_TOKEN=                         # … or an OAuth bearer token instead
